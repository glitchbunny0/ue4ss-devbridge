#!/usr/bin/env bash
# uedev — drive a UE4SS game through the DevBridge mod: run Lua live on the game thread,
# read/follow UE4SS.log, push mod folders, hot-swap shell-based mods, take screenshots.
# Everything happens through files in the game's ue4ss folder; a transport decides how
# uedev reaches that folder:
#   local   the folder is a path on this machine (Linux/Proton, Steam Deck, WSL, a mounted share)
#   ssh     a Windows box over SSH + PowerShell (lib/uedev/ssh.sh, docs/ssh.md)
#
#   uedev -e 'return find("PlayerController")'             run Lua in the game thread
#   uedev run file.lua | uedev run -                       ... from a file / stdin
#   uedev log [N] [REGEX]                                  last N log lines (default 40)
#   uedev follow [REGEX]                                   stream the log until Ctrl+C
#   uedev status                                           game running? bridge alive? armed?
#   uedev arm | disarm                                     kill switch: bridge runs requests only while armed
#   uedev clean                                            unregister every hook/loop added through the bridge
#   uedev shot [out.jpg]                                   engine screenshot, copied back and scaled to 1280 px
#   uedev push DIR                                         copy a mod folder into Mods/ (loads at the next game start)
#   uedev swap DIR                                         EXPERIMENTAL: push a hot-swap-shell mod and swap its
#                                                          logic in place, no restart (exit 1 if refused)
#   uedev ps < script.ps1                                  run PowerShell on the game box (ssh transport)
#
# Settings, from the environment or from ~/.config/uedev/config (KEY=value lines; the
# environment wins; the file is parsed, never executed):
#   UEDEV_UE4SS      the game's ue4ss folder (required): a path here, or the Windows path with ssh
#   UEDEV_TRANSPORT  local | ssh   (default: ssh when UEDEV_HOST is set, else local)
#   UEDEV_HOST       ssh target, e.g. player@192.168.1.20 (ssh transport)
#   UEDEV_PROCESS    game process name; default: the *-Shipping.exe beside ue4ss
#   UEDEV_SHOTS      screenshot folder; default: <LocalAppData>/<Project>/Saved/Screenshots/Windows
#   UEDEV_TIMEOUT    seconds to wait for an answer from the game (default 10)
#   UEDEV_CONFIG     alternative config file path
set -euo pipefail

CONF="${UEDEV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/uedev/config}"
if [[ -f "$CONF" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(UEDEV_[A-Z0-9_]+)=(.*)$ ]] || continue
        k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
        if [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
        [[ -n "${!k+x}" ]] || export "$k=$v"
    done < "$CONF"
fi

cmd="${1:-help}"; shift || true
if [[ "$cmd" == help || "$cmd" == -h || "$cmd" == --help ]]; then
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0
fi

if [[ -n "${UEDEV_TRANSPORT:-}" ]]; then TRANSPORT="$UEDEV_TRANSPORT"
elif [[ -n "${UEDEV_HOST:-}" ]]; then TRANSPORT=ssh
else TRANSPORT=local; fi
LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/uedev"
[[ "$TRANSPORT" =~ ^[a-z0-9_-]+$ && -f "$LIB/$TRANSPORT.sh" ]] \
    || { echo "uedev: unknown transport '$TRANSPORT' (have: $(cd "$LIB" && ls *.sh | sed 's/\.sh$//' | tr '\n' ' '))" >&2; exit 2; }
[[ -n "${UEDEV_UE4SS:-}" ]] || { echo "uedev: UEDEV_UE4SS is not set (environment or $CONF; see: uedev help)" >&2; exit 2; }
UE4SS="$UEDEV_UE4SS"
TIMEOUT="${UEDEV_TIMEOUT:-10}"

# Shared by the transports.
STATUS_LINES='UE4SS - v|\] v[0-9][0-9A-Za-z.+-]*( \([^)]*\))? loaded|loaded WITHOUT logic|swapped logic|swap REFUSED'
HOT_RELOAD_WARNING='UNSAFE once any mod hooks Blueprint functions (hang or crash on reload)'
SWAP_SILENT_HINT='it is not a hot-swap shell yet (restart the game once to load it), or the game thread is stuck.'

# A transport defines: t_init, t_lua ID REQUEST, t_log N REGEX, t_follow REGEX, t_status,
# t_arm arm|disarm, t_push DIR, t_swap DIR ID, t_shot_newest, t_fetch PATH DEST, t_ps.
# shellcheck source=/dev/null
source "$LIB/$TRANSPORT.sh"
t_init

new_id() { printf '%s-%s-%s' "$(date +%H%M%S)" "$$" "$RANDOM"; }

# One request: first line `--@id <id>`, then the Lua (see README, "The protocol").
run_lua() {
    local id; id="$(new_id)"
    t_lua "$id" "$(printf -- '--@id %s\n%s' "$id" "$1")"
}

need_dir() { [[ -d "$1" ]] || { echo "not a directory: $1" >&2; exit 2; }; }

case "$cmd" in
    -e) [[ $# -ge 1 ]] || { echo "usage: uedev -e 'lua'" >&2; exit 2; }; run_lua "$1" ;;
    run)
        f="${1:--}"
        if [[ "$f" == "-" ]]; then run_lua "$(cat)"; else run_lua "$(cat "$f")"; fi ;;
    log) t_log "${1:-40}" "${2:-}" ;;
    follow) t_follow "${1:-.}" ;;
    status)
        t_status
        if ssh_out="$(TIMEOUT=3 run_lua 'local ok, h = pcall(hello); if ok then local i = installed and installed() or { hooks = "?", loops = "?" }; return "hello", h.bridge, h.protocol, i.hooks, i.loops end; return "pong"' 2>&1)" && [[ "$ssh_out" == *"=> "* ]]; then
            if [[ "$ssh_out" == *"=> hello"* ]]; then
                proto="$(sed -n '3s/^=> //p' <<<"$ssh_out")"
                echo "bridge: answering (v$(sed -n '2s/^=> //p' <<<"$ssh_out"), protocol $proto)"
                echo "runtime hooks: $(sed -n '4s/^=> //p' <<<"$ssh_out"), loops: $(sed -n '5s/^=> //p' <<<"$ssh_out")  (uedev clean removes them)"
                [[ "$proto" == "1" ]] || echo "WARNING: bridge protocol $proto, this uedev speaks 1"
            else
                echo "bridge: answering (pre-handshake build)"
            fi
        else
            echo "bridge: not answering ($(head -c 160 <<<"$ssh_out"))"
        fi ;;
    clean) run_lua 'return cleanup()' ;;
    shot)
        # Engine screenshot ("shot" console command), copied back and scaled for viewing.
        out="${1:-${TMPDIR:-/tmp}/uedev-shot-$(date +%H%M%S).jpg}"
        before="$(t_shot_newest)"
        run_lua 'local pc = find("PlayerController"); call(StaticFindObject("/Script/Engine.Default__KismetSystemLibrary"), "ExecuteConsoleCommand", pc, "shot", pc); return "ok"' >/dev/null
        now=""
        for _ in $(seq 1 20); do
            sleep 0.5
            now="$(t_shot_newest)"
            [[ -n "$now" && "$now" != "$before" ]] && break
        done
        [[ -n "$now" && "$now" != "$before" ]] || { echo "no new screenshot appeared (set UEDEV_SHOTS if the game saves elsewhere)" >&2; exit 1; }
        sleep 0.5   # let the PNG finish writing
        png="${out%.*}.png"
        t_fetch "${now%%|*}" "$png"
        if command -v ffmpeg >/dev/null; then
            ffmpeg -loglevel error -y -i "$png" -vf scale=1280:-1 "$out" && rm -f "$png" && echo "$out"
        else
            echo "$png"
        fi ;;
    arm|disarm) t_arm "$cmd" ;;
    push)
        d="${1:?usage: uedev push DIR}"; d="${d%/}"; need_dir "$d"
        t_push "$d" ;;
    swap)
        # Hot swap for a mod whose main.lua is a hot-swap shell (see README): the files land,
        # then Mods/<name>/hotswap/req holding an id; the shell answers in hotswap/<id>.out.
        # It re-runs its logic files in the SAME Lua state, so hooks stay valid; UE4SS's own
        # reload is never involved.
        d="${1:?usage: uedev swap DIR}"; d="${d%/}"; need_dir "$d"
        id="$(new_id)"
        t0="$(date +%s%N)"
        res="$(t_swap "$d" "$id")"
        ms=$(( ($(date +%s%N) - t0) / 1000000 ))
        printf '%s\n(%s, %d ms round trip)\n' "${res%$'\n'}" "$(basename "$d")" "$ms"
        [[ "$res" == OK* ]] ;;
    ps) t_ps ;;
    *) echo "unknown command: $cmd (try: uedev help)" >&2; exit 2 ;;
esac
